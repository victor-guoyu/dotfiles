# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time oh-my-zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="robbyrussell"

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Add wisely, as too many plugins slow down shell startup.
plugins=(
    git
    zsh-autosuggestions
    zsh-completions
    zsh-history-substring-search
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# User configuration
# PATH and static env exports live in ~/.zprofile (see zsh/zprofile).
# This file keeps interactive-only setup: functions, hooks, completions, aliases.

# editor aliases
alias vi="nvim"
alias vim="nvim"

# fnm — PATH shim for the active node, plus a chpwd hook that switches version
# per directory (.node-version / .nvmrc / package.json engines)
command -v fnm >/dev/null && eval "$(fnm env --use-on-cd --shell zsh)"

# pyenv — defines the `pyenv` shell function (PYENV_ROOT/bin is on PATH in .zprofile)
command -v pyenv >/dev/null && eval "$(pyenv init -)"

# zoxide — defines the `z` function and a precmd hook
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
